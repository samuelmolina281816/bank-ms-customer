      "name": "Customer lifecycle - Personal",
      "item": [
        {
          "name": "01 - Create personal customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dni = String(Date.now() % 90000000 + 10000000);",
                  "pm.collectionVariables.set('documentNumber', dni);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created with HTTP 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Response contains public customer number and ACTIVE status', function () {",
                  "  pm.expect(body.customerNumber).to.be.a('number');",
                  "  pm.expect(body.status).to.eql('ACTIVE');",
                  "  pm.expect(body.profile).to.eql('STANDARD');",
                  "  pm.expect(body).not.to.have.property('id');",
                  "});",
                  "pm.collectionVariables.set('customerNumber', String(body.customerNumber));",
                  "pm.test('Response preserves the generated DNI', function () { pm.expect(body.documentNumber).to.eql(pm.collectionVariables.get('documentNumber')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "postman-customer-create-personal"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerType\": \"PERSONAL\",\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"{{documentNumber}}\",\n  \"firstName\": \"Ana\",\n  \"lastName\": \"Lopez\",\n  \"email\": \"ana.lopez@example.com\",\n  \"phone\": \"5551234567\",\n  \"address\": \"Av. Principal 123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer"
              ]
            },
            "description": "Genera un DNI distinto en cada ejecucion y guarda el customerNumber para las siguientes solicitudes."
          },
          "response": []
        },
