    {
      "name": "Customer lifecycle - Business",
      "item": [
        {
          "name": "01 - Create business customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = String(Date.now()).slice(-9);",
                  "pm.collectionVariables.set('businessRuc', '20' + suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Business customer created with HTTP 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Business response has RUC, business name and no personal names', function () {",
                  "  pm.expect(body.documentType).to.eql('RUC');",
                  "  pm.expect(body.businessName).to.eql('Acme Peru S.A.C.');",
                  "  pm.expect(body.firstName).to.be.oneOf([null, undefined]);",
                  "  pm.expect(body.lastName).to.be.oneOf([null, undefined]);",
                  "});",
                  "pm.collectionVariables.set('businessCustomerNumber', String(body.customerNumber));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerType\": \"BUSINESS\",\n  \"documentType\": \"RUC\",\n  \"documentNumber\": \"{{businessRuc}}\",\n  \"businessName\": \"Acme Peru S.A.C.\",\n  \"email\": \"contacto@acme.example\",\n  \"phone\": \"555111222\"\n}",
              "options": {
