                "exec": [
                  "pm.test('Eligibility is minimal and active', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.customerNumber).to.eql(Number(pm.collectionVariables.get('vipCustomerNumber')));",
                  "  pm.expect(body.customerType).to.eql('PERSONAL');",
                  "  pm.expect(body.profile).to.eql('VIP');",
                  "  pm.expect(body.status).to.eql('ACTIVE');",
                  "  pm.expect(body.eligible).to.eql(true);",
                  "  ['documentNumber', 'email', 'phone', 'address', 'id'].forEach(function (field) { pm.expect(body).not.to.have.property(field); });",
                  "});"
