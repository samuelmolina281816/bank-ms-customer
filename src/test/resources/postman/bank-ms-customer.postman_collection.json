    {
      "name": "Phase II - Customer profiles and public eligibility",
      "item": [
        {
          "name": "01 - Create PERSONAL VIP customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dni = String(Math.floor(10000000 + Math.random() * 90000000));",
                  "pm.collectionVariables.set('vipDocumentNumber', dni);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created with HTTP 201 and VIP profile', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.customerType).to.eql('PERSONAL');",
                  "  pm.expect(body.profile).to.eql('VIP');",
                  "  pm.collectionVariables.set('vipCustomerNumber', String(body.customerNumber));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerType\": \"PERSONAL\",\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"{{vipDocumentNumber}}\",\n  \"firstName\": \"Eva\",\n  \"lastName\": \"VIP\",\n  \"email\": \"eva.vip@example.com\",\n  \"phone\": \"5551234\",\n  \"profile\": \"VIP\"\n}",
